            },
            {
              "name": "price_le",
              "value": "={{ $('Set Config').first().json.price_le }}"
            },
            {
              "name": "region",
              "value": "={{ $json.region_code }}"
            }
          ]
        },
        "sendHeaders": false,
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "HTTP: GosPlan Contracts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ $('Set Config').first().json.wait_seconds }}",
        "unit": "seconds"
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Wait: Rate Limit",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        300
      ],
      "webhookId": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e"
    },
    {
      "parameters": {
        "jsCode": "// Получаем HTTP ответ (fullResponse=true → {statusCode, headers, body: [...]})\nconst httpData = $input.first().json;\nconst task = $('Split In Batches').item.json;\n\n// Извлекаем массив контрактов из ответа\nlet contracts = [];\nif (httpData.body && Array.isArray(httpData.body)) {\n  contracts = httpData.body;\n} else if (Array.isArray(httpData)) {\n  contracts = httpData;\n} else if (httpData.statusCode === 200 && typeof httpData.body === 'string') {\n  try { contracts = JSON.parse(httpData.body); } catch(e) { contracts = []; }\n}\n\nconst count = contracts.length;\n\n// Экранируем апострофы для SQL-интерполяции\nconst contractsJsonEscaped = JSON.stringify(contracts).replace(/'/g, \"''\");\n\n// Round-robin: если вернулось 100 — возможно ещё есть записи → skip+100, status=pending\nconst newSkip = count === 100 ? task.current_skip + 100 : task.current_skip;\nconst newStatus = count === 100 ? 'pending' : 'done';\n\nreturn [{\n  json: {\n    contracts_json_escaped: contractsJsonEscaped,\n    contracts_count: count,\n    task_id: task.id,\n    task_region: task.region_code,\n    task_month: task.month_start,\n    new_skip: newSkip,\n    new_status: newStatus,\n    records_delta: count,\n    http_status: httpData.statusCode || 'unknown'\n  }\n}];"
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Code: Process Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO contracts (\n  reg_num, purchase_number, plan_number, position_number,\n  subject, price, currency_code, stage,\n  customer, suppliers, ktru, okpd2,\n  region_code, published_at, updated_at,\n  exe_start, exe_end, source\n)\nSELECT\n  (c->>'reg_num')::varchar(50),\n  NULLIF(c->>'purchase_number', '')::varchar(50),\n  NULLIF(c->>'plan_number', '')::varchar(50),\n  NULLIF(c->>'position_number', '')::varchar(50),\n  c->>'subject',\n  NULLIF(c->>'price', '')::numeric,\n  COALESCE(c->>'currency_code', 'RUB')::varchar(10),\n  COALESCE(c->>'stage', '')::varchar(10),\n  NULLIF(c->>'customer', '')::varchar(12),\n  ARRAY(SELECT jsonb_array_elements_text(COALESCE(c->'suppliers', '[]'::jsonb))),\n  ARRAY(SELECT jsonb_array_elements_text(COALESCE(c->'ktru', '[]'::jsonb))),\n  ARRAY(SELECT jsonb_array_elements_text(COALESCE(c->'okpd2', '[]'::jsonb))),\n  NULLIF(c->>'region', '')::integer,\n  NULLIF(c->>'published_at', '')::timestamptz,\n  NULLIF(c->>'updated_at', '')::timestamptz,\n  NULLIF(c->>'exe_start', '')::date,\n  NULLIF(c->>'exe_end', '')::date,\n  c\nFROM jsonb_array_elements('{{ $json.contracts_json_escaped }}'::jsonb) AS c\nWHERE c->>'reg_num' IS NOT NULL\nON CONFLICT (reg_num) DO NOTHING;",
        "options": {}
      },
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "Postgres: Insert Contracts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1760,
        300
      ],
      "credentials": {
