        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO collection_tasks (region_code, month_start, month_end)\nSELECT\n  r.n AS region_code,\n  d.month_start::date,\n  (d.month_start + INTERVAL '1 month' - INTERVAL '1 day')::date AS month_end\nFROM generate_series(1, 99) AS r(n)\nCROSS JOIN (\n  SELECT generate_series('2025-01-01'::date, '2026-02-01'::date, INTERVAL '1 month') AS month_start\n) AS d\nON CONFLICT (region_code, month_start) DO NOTHING;",
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Postgres: Seed Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "WA0Gs2d5zXEHnfsq",
          "name": "gosplan"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM collection_tasks\nWHERE status = 'pending'\nORDER BY current_skip ASC, region_code ASC, month_start ASC\nLIMIT {{ $('Set Config').first().json.batch_limit }};",
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Postgres: Get Batch",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        660,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "WA0Gs2d5zXEHnfsq",
          "name": "gosplan"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
