          "id": "WA0Gs2d5zXEHnfsq",
          "name": "gosplan"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE collection_tasks SET\n  current_skip = {{ $('Code: Process Response').first().json.new_skip }},\n  status = '{{ $('Code: Process Response').first().json.new_status }}',\n  records_collected = records_collected + {{ $('Code: Process Response').first().json.records_delta }},\n  updated_at = NOW()\nWHERE id = {{ $('Code: Process Response').first().json.task_id }};",
        "options": {}
      },
      "id": "a1b2c3d4-0010-0010-0010-000000000010",
      "name": "Postgres: Update Task",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
