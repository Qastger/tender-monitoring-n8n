          "id": "WA0Gs2d5zXEHnfsq",
          "name": "gosplan"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  region_code::text,\n  ktru_code,\n  total_contracts::text,\n  unique_suppliers::text,\n  competition_ratio::text,\n  COALESCE(median_ratio, 0)::text AS median_ratio,\n  COALESCE(winner_inn, '') AS winner_inn,\n  COALESCE(winner_concentration, 0)::text AS winner_pct,\n  status\nFROM target_niches\nWHERE status != 'toxic'\nORDER BY competition_ratio DESC\nLIMIT 50;",
        "options": {}
      },
      "id": "c3a10004-0004-0004-0004-000000000004",
      "name": "Postgres: Get Niches",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [560, 400],
      "credentials": {
        "postgres": {
          "id": "WA0Gs2d5zXEHnfsq",
          "name": "gosplan"
        }
      }
    },
    {
